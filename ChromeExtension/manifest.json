{
  "manifest_version": 3,
  "name": "RAM Login Helper",
  "version": "1.0.9",
  "description": "Dang nhap Roblox bang Chrome an danh va luu tai khoan vao ung dung RAM tren may.",
  "key": "",
  "minimum_chrome_version": "116",
  "incognito": "spanning",
  "permissions": [
    "nativeMessaging",
    "cookies",
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://roblox.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
